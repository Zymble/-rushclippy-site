---
/** /legal/* pages: privacy, cookies, terms, acceptable use. Text lives in src/content/legal.ts. */
import type { Locale } from '@/config/routes';
import { site } from '@/config/site';
import { legalDocs, legalUi, type Block, type LegalId } from '@/content/legal';

interface Props {
  locale: Locale;
  id: LegalId;
}
const { locale, id } = Astro.props;
const doc = legalDocs[id][locale];
const ui = legalUi[locale];
const email = site.privacyEmail;

// Fill placeholders; {email} becomes a mailto link when the inbox is configured.
const fill = (text: string) => {
  const safe = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\{controller\}/g, site.controller);
  return safe.replace(
    /\{email\}/g,
    email ? `<a href="mailto:${email}" class="underline">${email}</a>` : ui.noEmail,
  );
};
const isList = (b: Block): b is { list: string[] } => typeof b === 'object' && 'list' in b;
const isTable = (b: Block): b is { table: { head: string[]; rows: string[][] } } =>
  typeof b === 'object' && 'table' in b;
const slug = (s: string, i: number) =>
  `s${i + 1}-` +
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const updated = new Intl.DateTimeFormat(locale === 'pt-br' ? 'pt-BR' : locale, {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(new Date(site.legalUpdated));
---

<article class="container-cr grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)]">
  <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
    <h2 class="text-cr-label text-cr-muted">{ui.contents}</h2>
    <ol class="mt-3 flex flex-col gap-1 text-sm">
      {doc.sections.map((s, i) => (
        <li>
          <a
            href={`#${slug(s.h, i)}`}
            class="inline-flex min-h-9 items-center text-cr-muted hover:text-cr-text"
          >
            {s.h}
          </a>
        </li>
      ))}
    </ol>
  </aside>

  <div class="lg-body">
    <h1 class="lg-title">{doc.title}</h1>
    <p class="mt-3 text-sm text-cr-muted">
      {ui.updated} <time datetime={site.legalUpdated}>{updated}</time>
    </p>
    <p class="lg-note mt-4 text-sm">{ui.review}</p>
    <p class="mt-8 text-lg leading-relaxed" set:html={fill(doc.intro)} />

    {doc.sections.map((s, i) => (
      <section aria-labelledby={slug(s.h, i)} class="mt-12">
        <h2 id={slug(s.h, i)} class="lg-h2">
          {s.h}
        </h2>
        {s.blocks.map((b) =>
          isList(b) ? (
            <ul class="lg-list mt-3">
              {b.list.map((li) => (
                <li set:html={fill(li)} />
              ))}
            </ul>
          ) : isTable(b) ? (
            <div class="lg-table mt-4" role="region" aria-label={s.h} tabindex="0">
              <table>
                <thead>
                  <tr>
                    {b.table.head.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {b.table.rows.map((r) => (
                    <tr>
                      {r.map((c, ci) => (ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="mt-3 leading-relaxed text-cr-muted" set:html={fill(b as string)} />
          ),
        )}
      </section>
    ))}

    <section class="mt-14 border-t border-cr-rule pt-6">
      <h2 class="lg-h2">{ui.contact}</h2>
      <p
        class="mt-3 leading-relaxed text-cr-muted"
        set:html={fill(`${site.controller}: {email}`)}
      />
    </section>
  </div>
</article>

<style>
  .lg-body {
    max-width: 72ch;
  }
  .lg-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: var(--cr-weight-display);
  }
  .lg-h2 {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    scroll-margin-top: 6rem;
  }
  .lg-note {
    color: var(--cr-muted);
    background: var(--cr-surface);
    border: 1px solid var(--cr-rule);
    border-radius: var(--cr-radius-control);
    padding: 0.625rem 0.875rem;
  }
  .lg-list {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--cr-muted);
    line-height: 1.7;
  }
  .lg-list li + li {
    margin-top: 0.25rem;
  }
  .lg-table {
    overflow-x: auto;
    border: 1px solid var(--cr-rule);
    border-radius: var(--cr-radius-control);
  }
  .lg-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .lg-table th,
  .lg-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--cr-rule);
  }
  .lg-table thead th {
    font-weight: 650;
    color: var(--cr-text);
    background: var(--cr-surface);
  }
  .lg-table tbody th {
    font-weight: 600;
    color: var(--cr-text);
  }
  .lg-table td {
    color: var(--cr-muted);
  }
  .lg-table tr:last-child th,
  .lg-table tr:last-child td {
    border-bottom: 0;
  }
</style>
